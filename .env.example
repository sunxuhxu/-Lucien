# ===== 许墨 · Lucien 智能体 配置 =====
# 复制本文件为 .env 并填入你自己的配置后重启服务。

# OpenAI 兼容 API Key（必填）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# 接口地址（可选）
# 官方 OpenAI：可留空
# 国内/第三方兼容服务：填写对应 base_url，例如：
#   DeepSeek   https://api.deepseek.com/v1
#   月之暗面   https://api.moonshot.cn/v1
#   智谱       https://open.bigmodel.cn/api/paas/v4
#   阿里通义   https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=

# 模型名称（按 provider 修改）
MODEL=gpt-4o-mini

# ===== 图像生成 API（可选，不填则复用上面的 OPENAI_* 配置）=====
# 图生图/文生图独立走国内平台时配置，例如硅基流动（https://siliconflow.cn 注册获取 Key）：
#   IMAGE_API_KEY=sk-你的硅基流动Key
#   IMAGE_BASE_URL=https://api.siliconflow.cn/v1
#   IMAGE_MODEL=Kwai-Kolors/Kolors
# 其他可选图像模型（硅基流动）：
#   Qwen/Qwen-Image          通义千问生图，质量高
#   Qwen/Qwen-Image-Edit-2509 通义图像编辑
#   black-forest-labs/FLUX.1-schnell  FLUX 快速版
# 智谱用户：IMAGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 网关走系统代理时（如 vectorengine.ai 等境外中转）：IMAGE_TRUST_ENV=1
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=
IMAGE_TRUST_ENV=

# 图像模型路由（可选）：
#   画面含角色/人物的图（许墨入画、化身、居民肖像等）→ 走 IMAGE_*（角色模型）
#   纯场景/氛围插画（记忆、签语卡、世界地点等）→ 走 OPENAI_*（agnes 等文生图模型）
# AGNES_IMAGE_MODEL 仅在纯场景图使用，默认 agnes-image-2.1-flash
AGNES_IMAGE_MODEL=

# 生图余额（月度配额，本地计数）：0 或留空 = 不限量
# 每次成功生图（画境、化身、朋友圈、世界等所有场景）记一次，跨月自动清零
# 配额用尽后，画境的图生图/化身会拦截并提示
IMAGE_MONTHLY_QUOTA=0

# 生成参数（可选）
TEMPERATURE=0.85
TOP_P=0.9
MAX_TOKENS=800

# 服务端口（可选）
PORT=8000
